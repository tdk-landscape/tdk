#!/usr/bin/env python3
"""
TDK CLI - Command line interface for the TDK platform
"""

import argparse
import json
import sys
from pathlib import Path

def validate_service(path):
    """Validate a service.json manifest."""
    service_json = Path(path) / "service.json"
    
    if not service_json.exists():
        print(f"❌ No service.json found at {path}")
        return 1
    
    with open(service_json) as f:
        manifest = json.load(f)
    
    required = ["appName", "appType", "domain"]
    missing = [f for f in required if f not in manifest]
    
    if missing:
        print(f"❌ Missing required fields: {', '.join(missing)}")
        return 1
    
    print(f"✅ Service '{manifest['appName']}' is valid")
    return 0

def generate_configs(args):
    """Generate configuration files."""
    print(f"📝 Generating configs: {', '.join(args.types)}")
    # Implementation would call generators
    return 0

def main():
    parser = argparse.ArgumentParser(description="TDK Platform CLI")
    subparsers = parser.add_subparsers(dest="command", help="Commands")
    
    # validate command
    validate = subparsers.add_parser("validate", help="Validate service manifest")
    validate.add_argument("path", help="Path to service directory")
    
    # generate command
    generate = subparsers.add_parser("generate", help="Generate config files")
    generate.add_argument("types", nargs="+", choices=["vite", "tsconfig", "prisma", "docker"])
    
    args = parser.parse_args()
    
    if args.command == "validate":
        return validate_service(args.path)
    elif args.command == "generate":
        return generate_configs(args)
    else:
        parser.print_help()
        return 1

if __name__ == "__main__":
    sys.exit(main())
